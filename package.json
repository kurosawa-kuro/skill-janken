{
  "name": "skill-janken-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser/scaffold.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write src scripts tests package.json .prettierrc.json",
    "format:check": "prettier --check src scripts tests package.json .prettierrc.json",
    "check": "npm run format:check && npm test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@playwright/test": "1.64.1",
    "jsdom": "24.1.3",
    "prettier": "3.6.2"
  }
}
